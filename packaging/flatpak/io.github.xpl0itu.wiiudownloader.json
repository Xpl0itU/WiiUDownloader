{
    "id": "io.github.xpl0itu.wiiudownloader",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "wiiudownloader",
    "finish-args": [
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-config/WiiUDownloader:create"
    ],
    "modules": [
        {
            "name": "wiiudownloader",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 WiiUDownloader /app/bin/wiiudownloader",
                "install -Dm644 io.github.xpl0itu.wiiudownloader.desktop /app/share/applications/io.github.xpl0itu.wiiudownloader.desktop",
                "install -Dm644 io.github.xpl0itu.wiiudownloader.metainfo.xml /app/share/metainfo/io.github.xpl0itu.wiiudownloader.metainfo.xml",
                "install -Dm644 WiiUDownloader.svg /app/share/icons/hicolor/scalable/apps/io.github.xpl0itu.wiiudownloader.svg"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "../../WiiUDownloader"
                },
                {
                    "type": "file",
                    "path": "io.github.xpl0itu.wiiudownloader.desktop"
                },
                {
                    "type": "file",
                    "path": "io.github.xpl0itu.wiiudownloader.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "../../data/WiiUDownloader.svg"
                }
            ]
        }
    ]
}